<mxfile host="app.diagrams.net"><diagram name="Arquitectura BI de cinco capas – Vigilancia de la contratación pública en Cundinamarca"><mxGraphModel dx="1500" dy="860" grid="1" gridSize="10" guides="1" page="1" pageWidth="1500" pageHeight="860"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Arquitectura BI de cinco capas – Vigilancia de la contratación pública en Cundinamarca" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="0" y="5" width="1500" height="34" as="geometry"/></mxCell><mxCell id="L1" value="&lt;b&gt;1. Fuentes de datos&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#1f4e79;fontSize=12;verticalAlign=top;align=center;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="320" height="590" as="geometry"/></mxCell><mxCell id="L2" value="&lt;b&gt;2. Integración (ETL)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf1e3;strokeColor=#b35c00;fontSize=12;verticalAlign=top;align=center;fontColor=#b35c00;" vertex="1" parent="1"><mxGeometry x="360" y="50" width="400" height="590" as="geometry"/></mxCell><mxCell id="L3" value="&lt;b&gt;3. Almacén de datos&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf6ea;strokeColor=#2e7d32;fontSize=12;verticalAlign=top;align=center;fontColor=#2e7d32;" vertex="1" parent="1"><mxGeometry x="780" y="50" width="330" height="590" as="geometry"/></mxCell><mxCell id="L4" value="&lt;b&gt;4. Usuario final&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecf8;strokeColor=#6a1b9a;fontSize=12;verticalAlign=top;align=center;fontColor=#6a1b9a;" vertex="1" parent="1"><mxGeometry x="1130" y="50" width="350" height="590" as="geometry"/></mxCell><mxCell id="L5" value="&lt;b&gt;5. Gobierno, metadatos, monitoreo y seguridad (capa transversal)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#555555;fontSize=12;verticalAlign=top;align=center;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="1460" height="185" as="geometry"/></mxCell><mxCell id="F1" value="&lt;b&gt;F1 · Colombia Compra Eficiente&lt;/b&gt;&lt;br&gt;SECOP II – Contratos Electrónicos&lt;br&gt;datos.gov.co · id jbjy-vk9h&lt;br&gt;CSV vía API SODA&lt;br&gt;Cundinamarca · firmas 2023–2025" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="35" y="100" width="290" height="150" as="geometry"/></mxCell><mxCell id="F2" value="&lt;b&gt;F2 · Colombia Compra Eficiente&lt;/b&gt;&lt;br&gt;SECOP II – Procesos de Contratación&lt;br&gt;datos.gov.co · id p6dx-8zbt&lt;br&gt;JSON vía API SODA&lt;br&gt;procesos ligados a F1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="35" y="275" width="290" height="150" as="geometry"/></mxCell><mxCell id="F3" value="&lt;b&gt;F3 · DANE&lt;/b&gt;&lt;br&gt;Índice de Precios al Consumidor&lt;br&gt;(anexo sep. 2026, hoja 13:&lt;br&gt;IPC de servicios mensual)&lt;br&gt;XLSX · deflactor a pesos constantes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="35" y="450" width="290" height="150" as="geometry"/></mxCell><mxCell id="EX" value="&lt;b&gt;Extracción&lt;/b&gt;&lt;br&gt;Pentaho PDI&lt;br&gt;(Spoon)&lt;br&gt;&lt;br&gt;CSV file input&lt;br&gt;&lt;br&gt;REST client&lt;br&gt;(JSON)&lt;br&gt;&lt;br&gt;Microsoft&lt;br&gt;Excel input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="375" y="90" width="125" height="525" as="geometry"/></mxCell><mxCell id="ST" value="&lt;b&gt;Staging · PostgreSQL&lt;/b&gt;&lt;br&gt;esquema stg&lt;br&gt;stg_contrato · stg_proceso&lt;br&gt;stg_ipc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="225" height="100" as="geometry"/></mxCell><mxCell id="TR" value="&lt;b&gt;Transformaciones (.ktr)&lt;/b&gt;&lt;br&gt;fechas texto con hora → DATE&lt;br&gt;valores texto → NUMERIC&lt;br&gt;quitar duplicados de F2&lt;br&gt;catálogos homologados&lt;br&gt;«No Definido» → desconocido&lt;br&gt;hash del documento del&lt;br&gt;proveedor persona natural" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="210" width="225" height="190" as="geometry"/></mxCell><mxCell id="CA" value="&lt;b&gt;Trabajos (.kjb)&lt;/b&gt;&lt;br&gt;1) dimensiones (SCD 1)&lt;br&gt;2) búsqueda de llaves&lt;br&gt;subrogadas&lt;br&gt;3) valor constante con IPC&lt;br&gt;4) fact_contrato&lt;br&gt;5) registro en etl_log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="420" width="225" height="195" as="geometry"/></mxCell><mxCell id="DW" value="&lt;b&gt;PostgreSQL 16 · esquema dw&lt;/b&gt;&lt;br&gt;(modelo en estrella)&lt;br&gt;&lt;br&gt;dim_tiempo&lt;br&gt;dim_entidad&lt;br&gt;dim_proveedor&lt;br&gt;dim_modalidad&lt;br&gt;dim_objeto_contractual&lt;br&gt;&lt;br&gt;fact_contrato" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="795" y="90" width="300" height="260" as="geometry"/></mxCell><mxCell id="SM" value="&lt;b&gt;Modelo semántico Power BI&lt;/b&gt;&lt;br&gt;(cubo tabular)&lt;br&gt;Medidas DAX: valor constante,&lt;br&gt;% contratación directa, días a firma,&lt;br&gt;concentración de proveedores" style="rounded=1;whiteSpace=wrap;html=1;fillCo