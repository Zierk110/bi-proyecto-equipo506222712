<mxfile host="app.diagrams.net"><diagram name="Esquema dimensional en estrella – contratos SECOP II Cundinamarca"><mxGraphModel dx="1300" dy="920" grid="1" gridSize="10" guides="1" page="1" pageWidth="1300" pageHeight="920"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Esquema dimensional en estrella – contratos SECOP II Cundinamarca" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="0" y="5" width="1300" height="34" as="geometry"/></mxCell><mxCell id="dt" value="dim_tiempo" style="swimlane;html=1;startSize=26;fillColor=#1f4e79;fontColor=#ffffff;strokeColor=#1f4e79;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;rounded=0;" vertex="1" parent="1"><mxGeometry x="480" y="55" width="320" height="212" as="geometry"/></mxCell><mxCell id="dt_f" value="&lt;b&gt;&lt;font color='#9c2a00'&gt;PK  fecha_key  INT (aaaammdd)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;fecha  DATE&lt;br&gt;dia  SMALLINT&lt;br&gt;nombre_dia  VARCHAR(10)&lt;br&gt;mes  SMALLINT&lt;br&gt;nombre_mes  VARCHAR(12)&lt;br&gt;trimestre  SMALLINT&lt;br&gt;anio  SMALLINT&lt;br&gt;ipc_indice_mes  NUMERIC(8,2)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="dt"><mxGeometry x="0" y="26" width="320" height="186" as="geometry"/></mxCell><mxCell id="de" value="dim_entidad" style="swimlane;html=1;startSize=26;fillColor=#1f4e79;fontColor=#ffffff;strokeColor=#1f4e79;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;rounded=0;" vertex="1" parent="1"><mxGeometry x="920" y="55" width="350" height="212" as="geometry"/></mxCell><mxCell id="de_f" value="&lt;b&gt;&lt;font color='#9c2a00'&gt;PK  entidad_key  SERIAL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;nit_entidad  VARCHAR(15)&lt;br&gt;nombre_entidad  VARCHAR(200)&lt;br&gt;orden  VARCHAR(30)&lt;br&gt;sector  VARCHAR(80)&lt;br&gt;rama  VARCHAR(30)&lt;br&gt;entidad_centralizada  VARCHAR(30)&lt;br&gt;ciudad  VARCHAR(60)&lt;br&gt;departamento  VARCHAR(40)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="de"><mxGeometry x="0" y="26" width="350" height="186" as="geometry"/></mxCell><mxCell id="dm" value="dim_modalidad" style="swimlane;html=1;startSize=26;fillColor=#1f4e79;fontColor=#ffffff;strokeColor=#1f4e79;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;rounded=0;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="340" height="132" as="geometry"/></mxCell><mxCell id="dm_f" value="&lt;b&gt;&lt;font color='#9c2a00'&gt;PK  modalidad_key  SERIAL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;justificacion_modalidad  VARCHAR(150)&lt;br&gt;modalidad_contratacion  VARCHAR(80)&lt;br&gt;tipo_seleccion  VARCHAR(20)&lt;br&gt;(competitiva / no competitiva)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="dm"><mxGeometry x="0" y="26" width="340" height="106" as="geometry"/></mxCell><mxCell id="fc" value="fact_contrato" style="swimlane;html=1;startSize=26;fillColor=#9c2a00;fontColor=#ffffff;strokeColor=#9c2a00;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;rounded=0;" vertex="1" parent="1"><mxGeometry x="470" y="390" width="350" height="332" as="geometry"/></mxCell><mxCell id="fc_f" value="&lt;b&gt;&lt;font color='#9c2a00'&gt;PK  contrato_sk  BIGSERIAL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#1f4e79'&gt;FK  fecha_firma_key → dim_tiempo&lt;/font&gt;&lt;br&gt;&lt;font color='#1f4e79'&gt;FK  entidad_key → dim_entidad&lt;/font&gt;&lt;br&gt;&lt;font color='#1f4e79'&gt;FK  proveedor_key → dim_proveedor&lt;/font&gt;&lt;br&gt;&lt;font color='#1f4e79'&gt;FK  modalidad_key → dim_modalidad&lt;/font&gt;&lt;br&gt;&lt;font color='#1f4e79'&gt;FK  objeto_key → dim_objeto_contractual&lt;/font&gt;&lt;br&gt;DD  id_contrato  VARCHAR(30)&lt;br&gt;DD  proceso_de_compra  VARCHAR(30)&lt;br&gt;DD  estado_contrato  VARCHAR(40)&lt;br&gt;valor_contrato  NUMERIC(18,2)&lt;br&gt;valor_contrato_constante  NUMERIC(18,2)&lt;br&gt;valor_pagado  NUMERIC(18,2)&lt;br&gt;duracion_dias  INT&lt;br&gt;dias_publicacion_a_firma  INT&lt;br&gt;conteo_contratos  SMALLINT" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="fc"><mxGeometry x="0" y="26" width="350" height="306" as="geometry"/></mxCell><mxCell id="dp" value="dim_proveedor" style="swimlane;html=1;startSize=26;fillColor=#1f4e79;fontColor=#ffffff;strokeColor=#1f4e79;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;rounded=0;" vertex="1" parent="1"><mxGeometry x="920" y="430" width="350" height="192" as="geometry"/></mxCell><mxCell id="dp_f" value="&lt;b&gt;&lt;font color='#9c2a00'&gt;PK  proveedor_key  SERIAL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;proveedor_hash  CHAR(64)&lt;br&gt;nombre_proveedor  VARCHAR(200)&lt;br&gt;(solo personas jurídicas)&lt;br&gt;tipo_documento  VARCHAR(40)&lt;br&gt;tipo_persona  VARCHAR(10)&lt;br&gt;es_pyme  BOOLEAN&lt;br&gt;es_grupo  BOOLEAN" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="dp"><mxGeometry x="0" y="26" width="350" height="166" as="geometry"/></mxCell><mxCell id="do" value="dim_objeto_contractual" style="swimlane;html=1;startSize=26;fillColor=#1f4e79;fontColor=#ffffff;strokeColor=#1f4e79;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;rounded=0;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="340" height="152" as="geometry"/></mxCell><mxCell id="do_f" value="&lt;b&gt;&lt;font color='#9c2a00'&gt;PK  objeto_key  SERIAL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;codigo_unspsc  VARCHAR(12)&lt;br&gt;clase_unspsc  CHAR(6)&lt;br&gt;familia_unspsc  CHAR(4)&lt;br&gt;segmento_unspsc  CHAR(2)&lt;br&gt;tipo_de_contrato  VARCHAR(60)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="do"><mxGeometry x="0" y="26" width="340" height="126" as="geometry"/></mxCell><mxCell id="ley" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;PK = llave primaria · FK = llave foránea&lt;br&gt;DD = dimensión degenerada&lt;br&gt;Grano: un contrato electrónico firmado&lt;br&gt;por una entidad de Cundinamarca" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="920" y="720" width="350" height="160" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555;strokeWidth=1.5;" edge="1" parent="1" source="fc" target="dt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555;strokeWidth=1.5;" edge="1" parent="1" source="fc" target="de"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555;strokeWidth=1.5;" edge="1" parent="1" source="fc" target="dm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555;strokeWidth=1.5;" edge="1" parent="1" source="fc" target="dp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555;strokeWidth=1.5;" edge="1" parent="1" source="fc" target="do"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>